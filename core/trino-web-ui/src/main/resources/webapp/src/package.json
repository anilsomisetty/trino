{
  "name": "trino-webui",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.12.0",
    "@babel/preset-env": "^7.24.8",
    "@babel/preset-flow": "^7.24.7",
    "@babel/preset-react": "^7.12.10",
    "babel-loader": "^9.1.3",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "css-loader": "^7.1.2",
    "flow-bin": "^0.241.0",
    "prettier": "3.3.3",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "ag-grid-community": "^33.3.0",
    "ag-grid-react": "^33.3.0",
    "d3": "^5.7.0",
    "dagre-d3": "^0.6.1",
    "highlight.js": "^11.10.0",
    "react": "^16.4.2",
    "react-dom": "^16.4.2",
    "style-loader": "^4.0.0"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react",
      "@babel/preset-flow"
    ]
  },
  "plugins": [
    "transform-class-properties"
  ],
  "scripts": {
    "package": "npm install && webpack --config webpack.config.js",
    "package:clean": "npm clean-install && webpack --config webpack.config.js",
    "watch": "npm clean-install && webpack --config webpack.config.js --watch",
    "flow": "flow",
    "check": "npm install && flow && prettier --check **/*.js **/*.jsx *.js *.jsx",
    "check:clean": "npm clean-install && flow && prettier --check **/*.js **/*.jsx *.js *.jsx",
    "format": "prettier --write **/*.js **/*.jsx *.js *.jsx",
    "lint": "prettier --check **/*.js **/*.jsx"
  },
  "overrides": {
    "d3-color": "3.1.0"
  },
  "resolutions": {
    "d3-color": "3.1.0"
  }
}
